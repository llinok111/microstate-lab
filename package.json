{
  "name": "microstate-lab",
  "version": "0.1.0",
  "description": "A micro-interaction laboratory: state-driven feedback components with tunable duration, easing, delay and trigger, plus live preview and standalone code export.",
  "type": "module",
  "main": "dist/microstate.cjs",
  "module": "dist/microstate.js",
  "style": "dist/microstate.css",
  "exports": {
    ".": {
      "import": "./dist/microstate.js",
      "require": "./dist/microstate.cjs"
    },
    "./css": "./dist/microstate.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-concurrency=1 test/easing.test.mjs test/motion.test.mjs test/export.test.mjs test/styles.test.mjs",
    "test:browser": "node --test --test-concurrency=1 test/browser.test.mjs test/a11y.test.mjs test/export-runtime.test.mjs",
    "test:all": "npm test && npm run test:browser",
    "figures": "node scripts/figures.mjs",
    "figures:check": "node scripts/figures.mjs --check",
    "pack": "node scripts/pack.mjs"
  },
  "keywords": [
    "micro-interactions",
    "motion",
    "easing",
    "web-animations-api",
    "accessibility",
    "prefers-reduced-motion",
    "design-system",
    "web-components"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/llinok111/microstate-lab"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "sharp": "^0.35.5"
  }
}
